# Copy to .env and fill in your values. Never commit the real .env.
# Loaded automatically in development and test via dotenv-rails.

# --- Server ---
# Puma reads PORT (default 3000; the original Go service used 8082).
PORT=8082
# Public base URL, used for links in email.
BASE_URL=https://portal.arclineit.com
# SQLite database file path (absolute or relative to the app root).
DATABASE_PATH=storage/production.sqlite3
# arcline-uptime's SQLite database, opened read-only. Leave unset to hide service status.
UPTIME_DB_PATH=../uptime/storage/production.sqlite3

# --- First admin account (bin/rails db:seed) ---
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_NAME=Admin
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=

# --- SMTP (password resets and ticket notifications) ---
SMTP_HOST=mail.arclineit.com
SMTP_PORT=587
SMTP_USER=portal@arclineit.com
SMTP_PASS=
SMTP_FROM=portal@arclineit.com
# Receives new-ticket and client-reply notifications.
ADMIN_EMAIL=
