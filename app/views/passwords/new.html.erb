<% content_for :title, "Reset password — Arcline Portal" %>

<section class="section section--tight">
  <div class="container">
    <div class="auth">
      <div class="auth__header">
        <p class="eyebrow">Portal</p>
        <h1 class="auth__title">Reset your password</h1>
      </div>

      <%= form_with url: passwords_path, class: "form" do |form| %>
        <div class="field">
          <%= form.label :email_address, "Email" %>
          <%= form.email_field :email_address, autocomplete: "email", required: true, placeholder: "you@example.com" %>
          <p class="field__hint">We will email a link that is good for one hour.</p>
        </div>
        <%= form.submit "Send reset link", class: "btn btn--primary btn--full" %>
      <% end %>

      <div class="auth__links">
        <%= link_to "Back to log in", new_session_path %>
      </div>
    </div>
  </div>
</section>
