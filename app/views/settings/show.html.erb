<% content_for :title, "Settings — Arcline Portal" %>

<section class="page-header">
  <div class="container">
    <p class="eyebrow">Portal</p>
    <h1 class="page-header__title">Settings</h1>
    <p class="lead">Signed in as <%= current_client.username %>.</p>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="dash">
      <section class="dash-section">
        <h2 class="dash-section__title">email</h2>
        <div class="panel">
          <div class="panel__body">
            <%= form_with url: settings_email_path, method: :patch, class: "form" do |form| %>
              <div class="field">
                <%= form.label :email_address, "Email" %>
                <%= form.email_field :email_address, value: current_client.email_address, required: true, autocomplete: "email" %>
                <p class="field__hint">Used for password resets and ticket replies.</p>
              </div>
              <%= form.submit "Update email", class: "btn btn--primary" %>
            <% end %>
          </div>
        </div>
      </section>

      <section class="dash-section">
        <h2 class="dash-section__title">password</h2>
        <div class="panel">
          <div class="panel__body">
            <%= form_with url: settings_password_path, method: :patch, class: "form" do |form| %>
              <div class="field">
                <%= form.label :current_password, "Current password" %>
                <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72 %>
              </div>
              <div class="field">
                <%= form.label :password do %>New password <span class="field__optional">(min. 8 characters)</span><% end %>
                <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
              </div>
              <div class="field">
                <%= form.label :password_confirmation, "Confirm new password" %>
                <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
              </div>
              <%= form.submit "Change password", class: "btn btn--primary" %>
            <% end %>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>
